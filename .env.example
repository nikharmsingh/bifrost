# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Default model for the gateway, agents, and llm package
DEFAULT_MODEL=claude-sonnet-4-6
# Comma-separated extra models gateway callers may request
ALLOWED_MODELS=
# Model used by resume-analyzer (Vercel)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Groq (code-reviewer, resume-analyzer fallback)
GROQ_API_KEY=
# Groq retires models periodically — override here without a code change
GROQ_MODEL=openai/gpt-oss-120b

# Neon / Postgres (notes-api)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# API keys — when set, write/LLM endpoints require a matching X-API-Key header
GATEWAY_API_KEY=
NOTES_API_KEY=

# LangSmith (optional tracing)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=bifrost

# App settings
LOG_LEVEL=INFO
ENV=development
# Comma-separated allowed CORS origins (defaults to * when unset)
ALLOWED_ORIGINS=https://your-frontend.com
