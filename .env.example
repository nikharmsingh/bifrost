# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Default model for the gateway, agents, and llm package
DEFAULT_MODEL=claude-sonnet-4-6
# Comma-separated extra models gateway callers may request
ALLOWED_MODELS=

# Groq — only for local tools; deployed apps use each signed-in user's own key (saved in /settings)
GROQ_API_KEY=
# Groq retires models periodically — override here without a code change
GROQ_MODEL=openai/gpt-oss-120b

# Neon / Postgres (notes-api)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# API key — when set, the gateway requires a matching X-API-Key header
GATEWAY_API_KEY=

# Shared Bifrost sign-in (GitHub OAuth app — callback: https://<host>/auth/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Random secret that signs session cookies, e.g. python -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=
# Encrypts users' saved API keys (AES-GCM): 32 random bytes, urlsafe base64, e.g.
#   python -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
# Changing it makes saved keys unreadable — users would need to re-enter them.
KEY_ENCRYPTION_SECRET=
# Shared with the GitHub Actions secret of the same name; authorizes POST /status/check (uptime history)
STATUS_CHECK_SECRET=
# GitHub login that claims notes created before accounts existed
NOTES_OWNER_GITHUB_LOGIN=

# LangSmith (optional tracing)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=bifrost

# App settings
LOG_LEVEL=INFO
ENV=development
# Comma-separated allowed CORS origins (defaults to * when unset)
ALLOWED_ORIGINS=https://your-frontend.com
